# Cloudflare static asset headers (https://developers.cloudflare.com/workers/static-assets/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Frames live in a versioned folder (FRAMES_VERSION in src/lib/sequenceStore.ts), so they never
# change in place and can be cached for a year.
/frames/*
  Cache-Control: public, max-age=31536000, immutable

# Next.js build output is content-hashed.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
